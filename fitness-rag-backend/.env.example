# Google Gemini API key used for LLM text/image generation
GEMINI_API_KEY=your_gemini_api_key

# Gemini text model name (optional, defaults to gemini-2.5-flash)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Max retries for Gemini calls (optional, defaults to 2)
GEMINI_MAX_RETRIES=2

# Gemini image model name (optional, defaults to imagen-4.0-generate-001)
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# Pexels API key, used as a fallback/source for exercise photos
PEXELS_API_KEY=your_pexels_api_key

# "1" to enable AI-generated exercise images, "0" to disable (optional)
USE_AI_EXERCISE_IMAGES=0

# Google OAuth client ID for Google Calendar integration
GOOGLE_CLIENT_ID=your_google_client_id

# Google OAuth client secret for Google Calendar integration
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth redirect URI registered with Google for the calendar callback (optional)
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:9000/auth/google-calendar/callback

# URL of the frontend app, used for CORS/redirects (optional)
FRONTEND_URL=http://localhost:5173

# Garmin Connect account email, used to fetch Garmin dashboard data
GARMIN_EMAIL=your_garmin_email

# Garmin Connect account password
GARMIN_PASSWORD=your_garmin_password

# Which Garmin data-source adapter to use: "legacy" (default, unofficial
# garminconnect + GARMIN_EMAIL/PASSWORD above) or "official" (Garmin Health
# API OAuth 1.0a — data access requires an approved developer account).
GARMIN_ADAPTER=legacy
GARMIN_HEALTH_CLIENT_ID=
GARMIN_HEALTH_CLIENT_SECRET=

# Postgres password for the local "fitness_rag" database (user: postgres)
DB_PASSWORD=your_postgres_password

# Postgres host/port (optional). Defaults to localhost:5432 for local dev.
# docker-compose.yml overrides these to "postgres"/5432 for the containerized
# backend, since "localhost" inside a container means the container itself.
DB_HOST=localhost
DB_PORT=5432

# Fernet key (base64, 32 bytes) used to encrypt bloodTestImage at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The app refuses to start if this is unset while encrypted health data
# already exists in data/users.json.
HEALTH_DATA_KEY=

# YouTube Data API key, used to fetch exercise demo videos
YOUTUBE_API_KEY=your_youtube_api_key

# --- Retrieval tuning (optional, defaults shown) -----------------------------
# Max exercises returned per /ask call.
EXERCISE_RECOMMENDATION_LIMIT=8
# How many candidates to pull from the vector search before filtering.
VECTOR_SEARCH_RESULTS=24
# l2 (squared Euclidean) distance cutoff for "relevant" documents, range
# [0,4]. See the startup log for confirmation the Chroma collection is
# actually configured for l2 — see app.py's _assert_collection_space_is_l2.
DISTANCE_THRESHOLD=2.0
